{
  "name": "trinity-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:dev": "NODE_ENV=dev nest build",
    "build:prod": "NODE_ENV=prod nest build",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:local": "NODE_ENV=local nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "NODE_ENV= node dist/main",
    "test": "jest",
    "test:admin-access": "npm run build:dev && node scripts/admin-access-smoke.js",
    "test:admin-access:update": "npm run build:dev && node scripts/admin-access-smoke.js --update",
    "test:partner-transition-persistence": "npm run build:dev && node scripts/partner-transition-persistence-smoke.js",
    "audit:deal-distributors": "node scripts/deal-distributor-company-audit.js",
    "provision:deal-distributors": "node scripts/distributor-company-provisioning.js",
    "audit:legacy-data": "node scripts/legacy-data-audit.js",
    "backfill:ticket-assignees": "node scripts/ticket-assignee-backfill.js",
    "verify:audit": "npm test -- --runInBand && npm run test:admin-access && npm run test:partner-transition-persistence",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "migration:create": "npm run typeorm migration:create",
    "migration:run": "npm run typeorm migration:run -- -d ./config/typeorm.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d ./config/typeorm.ts",
    "configurator:import-xlsx": "node scripts/import-configurator-from-xlsx.js",
    "configurator:import-xlsx:execute": "node scripts/import-configurator-from-xlsx.js --execute",
    "configurator:import-recommended": "node scripts/import-recommended-configs-from-xlsx.js",
    "configurator:restore-backup": "node scripts/restore-configurator-backup.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "mpull": "git checkout master && git pull",
    "deploy": "./deploy.sh -n stage"
  },
  "dependencies": {
    "@css-inline/css-inline-linux-x64-gnu": "0.20.0",
    "@nestjs-modules/mailer": "2.1.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.40.3",
    "axios": "^1.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "handlebars": "^4.7.9",
    "hbs": "^4.2.0",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0",
    "nanoid": "^3.3.4",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@api/(.*)$": "<rootDir>/api/$1",
      "^@orm/(.*)$": "<rootDir>/orm/$1",
      "^@decorators/(.*)$": "<rootDir>/decorators/$1",
      "^@interceptors/(.*)$": "<rootDir>/interceptors/$1",
      "^@app/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/../config/$1",
      "^@integrations/(.*)$": "<rootDir>/integrations/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  }
}

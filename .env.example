NODE_ENV=prod
PORT=9131

HOSTNAME=xn--80akxggcl.xn--h1aaasnle.xn--p1ai
FRONTEND_HOSTNAME=xn--80akxggcl.xn--h1aaasnle.xn--p1ai
BACKEND_HOSTNAME=partner-api.trinity.ru
ALLOWED_ORIGINS=https://xn--80akxggcl.xn--h1aaasnle.xn--p1ai,https://partner-admin.trinity.ru

DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_USERNAME=trinity
DATABASE_PASSWORD=replace-with-database-password
DATABASE_NAME=trinity

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USERNAME=partner@example.com
EMAIL_PASSWORD=replace-with-smtp-password
EMAIL_FROM=partner@trinity.ru
EMAIL_SECURE=true
EMAIL_DEBUG=false
SMTP_SETTINGS_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

BITRIX24_WEBHOOK_URL=https://example.bitrix24.ru/rest/user/webhook
SCHEDULED_JOBS_ENABLED=true

# Generate independent values with: openssl rand -base64 48
LOGIN_CAPTCHA_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=trinity_session
CSRF_COOKIE_NAME=trinity_csrf
# Portal and API use different registrable domains, so the CSRF cookie must be
# host-only and travel through the portal's same-origin /api proxy.
CSRF_COOKIE_DOMAIN=
COOKIE_SECURE=true

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10

LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_FILES=30
METRICS_TOKEN=replace-with-at-least-24-random-characters
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

UPLOAD_DIR=public
READY_DISK_MIN_FREE_BYTES=1073741824

COOKIE_POLICY_VERSION=2026-09-17
PRIVACY_POLICY_VERSION=2026-09-17
USER_AGREEMENT_VERSION=2026-09-17
FEDERAL_LAWS_POLICY_VERSION=2026-09-17
